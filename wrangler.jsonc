{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baerngo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "baerngo"
    }
  ],
  "observability": {
    "enabled": true
  },
  // bärngo.live (Punycode xn--brngo-gra.live) — Custom Domains werden beim Deploy angelegt,
  // sobald die Zone im Cloudflare-Konto aktiv ist.
  "workers_dev": true,
  // Zonen-Routen statt Custom Domains: funktionieren auch mit den von Name.com importierten
  // (proxied) DNS-Einträgen. Sobald diese gelöscht sind, auf "custom_domain": true umstellen.
  "routes": [
    { "pattern": "xn--brngo-gra.live/*", "zone_id": "bcb5044f20006b4e449495c628b76e46" },
    { "pattern": "www.xn--brngo-gra.live/*", "zone_id": "bcb5044f20006b4e449495c628b76e46" }
  ]}
